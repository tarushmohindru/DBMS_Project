# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbon_credits_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20

# Database URL (for psql CLI commands)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/carbon_credits_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES=8h

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
